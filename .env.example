# Copie para .env e preencha. O .env fica fora do Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Modelo por função (padrão: GEMINI_MODEL). Modelos claude-* usam ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
GUIDE_MODEL=claude-haiku-5-5
DISCURSIVE_MODEL=claude-haiku-5-5
PLAN_MODEL=claude-haiku-5-5
ALLOWED_EMAILS=seu-email@exemplo.com
# Teto diário de gasto com IA por usuário, em USD (padrão 5). Quem está em AI_UNLIMITED_EMAILS não tem teto.
AI_DAILY_LIMIT_USD=5
AI_UNLIMITED_EMAILS=seu-email@exemplo.com
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# Senha do Postgres (Project Settings > Database), para migrações e testes do banco.
SUPABASE_DB_PASSWORD=

# Quest API (banco de questões), usada só no servidor.
QUEST_API_KEY=

# YouTube Data API v3 (aba Vídeos), usada só no servidor. Sem ela, a aba mostra só o link de busca.
YOUTUBE_API_KEY=
